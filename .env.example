# نسخة للتعبئة — انسخيها باسم .env على السيرفر واملئيها.
#
#   cp .env.example .env
#
# ملف .env ما بينرفع على git ولا بيدخل بصورة Docker — فيه كلمات سر ومفاتيح.
# ولا تبعتي محتواه بأي محادثة أو رسالة.


# ---------------------------------------------------------------- الدومين

# الدومين اللي حجزتيه، بدون https:// وبدون / بالآخر.
# لازم يكون DNS تبعه مأشّر على عنوان السيرفر قبل أول تشغيل، لأنه Caddy
# بيتحقق منه وقت جلب الشهادة.
DOMAIN=example.com


# ------------------------------------------------------- قاعدة البيانات

POSTGRES_DB=warehouse_db
POSTGRES_USER=warehouse

# كلمة سر طويلة وعشوائية. توليدها:
#   openssl rand -base64 32
POSTGRES_PASSWORD=


# ------------------------------------------------------------ التطبيق

# مفتاح توقيع الجلسات. لو تغيّر، بينطرد كل المستخدمين ويرجعوا يسجلوا دخول.
# ولا تستخدمي نفس المفتاح اللي على جهازك.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# أسرار العمليات الحساسة — نفس طريقة التوليد أعلاه
RESTORE_SECRET=
BOOTSTRAP_ADMIN_SECRET=


# --------------------------------------------------- تخزين الصور (R2)

# نفس القيم اللي على جهازك بالظبط — الصور موجودة هناك أصلاً،
# فالسيرفر الجديد بيقراها من نفس المكان وما بنحتاج ننقل ولا صورة.
STORAGE_BACKEND=r2
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=

# اختياري — يستخدم فقط لو بدك تحددي العنوان يدوياً بدل ما ينبني من
# R2_ACCOUNT_ID. اتركيه فاضي.
R2_ENDPOINT=


# ----------------------------------- النسخ الاحتياطية (حاوية منفصلة)

# حاوية مستقلة للنسخ، بمفاتيحها الخاصة. التطبيق بيشتغل على سيرفر مكشوف
# للإنترنت وحامل مفاتيح حاوية الصور — لو تسربت، ما بتوصل للنسخ.
# لو تركتيهم فاضيين، بترجع النسخ لحاوية الصور تحت مجلد backups/.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=


# ------------------------------------------------------------- إعدادات

TZ=Asia/Hebron

# waitress بيشتغل بعملية وحدة وهاد العدد من الخيوط.
# ما تزيدي عدد العمليات — قفل الاسترجاع بالذاكرة وبينكسر مع أكتر من عملية.
WAITRESS_THREADS=8
